# Copy to .env and fill in for your own Fabric workspace.
#
# FABRIC_SQL_SERVER is the Lakehouse SQL analytics endpoint. Find it in Fabric:
#   Workspace -> Lakehouse -> Settings -> SQL analytics endpoint -> Connection string
# FABRIC_SQL_DATABASE is the Lakehouse (or Warehouse) name.

FABRIC_SQL_SERVER=<your-endpoint>.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=<your_lakehouse_name>

# Optional: only the comparison demo (app.py, bench.py) needs these.
# The workspace GUID is in the Fabric URL: /groups/<guid>/. The data agent must be published.
# FABRIC_WORKSPACE_ID=<workspace-guid>
# FABRIC_DATA_AGENT_ID=<data-agent-guid>
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=<chat-model-deployment>
